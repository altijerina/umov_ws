<?xml version="1.0" encoding="UTF-8"?>

<robot name="arduino">
    <group name="arm">
        <chain base_link="base_link" tip_link="claw_support"/>
    </group>
    <group name="gripper">
        <joint name="joint_5"/>
        <chain base_link="claw_support" tip_link="gripper_right"/>
    </group>
    <group_state name="arm_home" group="arm">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="0"/>
        <joint name="joint_4" value="0"/>
    </group_state>
    <group_state name="arm_ready_low_left" group="arm">
        <joint name="joint_1" value="-1.0674"/>
        <joint name="joint_2" value="-1.4492"/>
        <joint name="joint_3" value="0.8591"/>
        <joint name="joint_4" value="0.6682"/>
    </group_state>
    <group_state name="arm_ready_low_right" group="arm">
        <joint name="joint_1" value="1.293"/>
        <joint name="joint_2" value="-1.4492"/>
        <joint name="joint_3" value="0.8591"/>
        <joint name="joint_4" value="0.6682"/>
    </group_state>
    <group_state name="arm_ready_high_left" group="arm">
        <joint name="joint_1" value="-1.0674"/>
        <joint name="joint_2" value="-0.3211"/>
        <joint name="joint_3" value="0.8591"/>
        <joint name="joint_4" value="-0.5641"/>
    </group_state>
    <group_state name="arm_ready_high_right" group="arm">
        <joint name="joint_1" value="1.5013"/>
        <joint name="joint_2" value="-0.3211"/>
        <joint name="joint_3" value="0.8591"/>
        <joint name="joint_4" value="-0.5641"/>
    </group_state>
    <group_state name="arm_ready_high_center" group="arm">
        <joint name="joint_1" value="-0.0434"/>
        <joint name="joint_2" value="-0.3211"/>
        <joint name="joint_3" value="0.8591"/>
        <joint name="joint_4" value="-0.5641"/>
    </group_state>
    <group_state name="arm_ready_low_center" group="arm">
        <joint name="joint_1" value="-0.0434"/>
        <joint name="joint_2" value="-1.3104"/>
        <joint name="joint_3" value="0.4773"/>
        <joint name="joint_4" value="0.8418"/>
    </group_state>

    <group_state name="gripper_home" group="gripper">
        <joint name="joint_5" value="0.0"/>
    </group_state>    

    <group_state name="gripper_ready" group="gripper">
        <joint name="joint_5" value="-0.7"/>
    </group_state>  

    <group_state name="gripper_grab" group="gripper">
        <joint name="joint_5" value="-0.15"/>
    </group_state>     

    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="claw_support" group="gripper" parent_group="arm"/>

    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="world" type="fixed" parent_frame="world" child_link="world"/>

    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="base_plate" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="forward_drive_arm" reason="Never"/>
    <disable_collisions link1="base_link" link2="rgb_camera" reason="Adjacent"/>
    <disable_collisions link1="base_plate" link2="forward_drive_arm" reason="Adjacent"/>
    <disable_collisions link1="base_plate" link2="rgb_camera" reason="Never"/>
    <disable_collisions link1="claw_support" link2="gripper_left" reason="Adjacent"/>
    <disable_collisions link1="claw_support" link2="gripper_right" reason="Adjacent"/>
    <disable_collisions link1="claw_support" link2="horizontal_arm" reason="Adjacent"/>
    <disable_collisions link1="forward_drive_arm" link2="gripper_left" reason="Never"/>
    <disable_collisions link1="forward_drive_arm" link2="horizontal_arm" reason="Adjacent"/>
    <disable_collisions link1="forward_drive_arm" link2="rgb_camera" reason="Never"/>
    <disable_collisions link1="gripper_left" link2="gripper_right" reason="Never"/>
    <disable_collisions link1="gripper_left" link2="horizontal_arm" reason="Never"/>
</robot>
